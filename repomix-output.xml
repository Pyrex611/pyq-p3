def genSignature(payload: str, time_stamp: str) -> str:
    param_str = time_stamp + BYBIT_API_KEY + _recv_window + str(payload)
    return hmac.new(
        BYBIT_SECRET_KEY.encode("utf-8"),
        param_str.encode("utf-8"),

<file path="pyquant_resilience.py">
"""
pyquant_resilience.py

Phase 1 (Pre-UI stabilization) — retry/backoff for the Binance Algo Order
API calls that place and cancel bracket (TP/SL) orders.

Why: `PositionGuard._place_bracket_order()` / `_place_bracket_order_fallback()`
/ `_cancel_sibling_algo_order()` previously wrapped a single network call in
a bare try/except — one transient error (timeout, 5xx, a dropped
connection) and the function just logs and gives up, leaving a position
with NO stop-loss or take-profit on the exchange. Given this project's own
history (per the original grading: "Binance API errors, positions not
closing" was the single biggest live-reliability complaint), this is the
highest-value resilience fix available.

Idempotency note: Binance's Algo Order "post" endpoint has no
client-supplied order-id field to de-duplicate a retry against (unlike
`futures_create_order`'s `newClientOrderId`). A request that times out
server-side-success/client-side-failure and then succeeds again on retry
could in principle place two STOP_MARKET or TAKE_PROFIT_MARKET orders for
the same position. `retry_algo_order()` guards against this by checking
the symbol's currently open algo orders before each retry attempt (not
before the first attempt, to avoid an extra API call on the common case)
and aborting the retry if an order of the same type already exists.
"""
from __future__ import annotations

import logging
import random
import time
from typing import Any, Callable, Optional

logger = logging.getLogger("pyquant.resilience")

# Errors worth retrying: timeouts, connection resets, and Binance's own
# transient/rate-limit codes. NOT retried: anything that looks like a
# rejected order (bad params, insufficient margin, etc.) — retrying those
# would just fail the same way N times and delay the fallback path.
_RETRYABLE_SNIPPETS = (
    "timed out", "timeout", "connection", "reset by peer",
    "-1021",  # INVALID_TIMESTAMP (clock skew — often transient)
    "-1001",  # DISCONNECTED
    "-1003",  # TOO_MANY_REQUESTS
    "502", "503", "504",
)


def _is_retryable(exc: Exception) -> bool:
    msg = str(exc).lower()
    return any(snippet in msg for snippet in _RETRYABLE_SNIPPETS)


def is_duplicate_order_error(exc: Exception) -> bool:
    """
    True if `exc` looks like Binance rejecting an order as a duplicate of
    one already placed (its error text includes "duplicate") — the
    expected, SAFE outcome of retrying `futures_create_order` after a
    prior attempt's response was lost, when a deterministic
    `newClientOrderId` was supplied (see signal_executor() in pyq_p4.py).
    This is not a failure; the caller should treat it as "already placed"
    and look the order up by client id.
    """
    return "duplicate" in str(exc).lower()


def is_already_closed_error(exc: Exception) -> bool:
    """
    True if `exc` looks like Binance rejecting a reduce-only close because
    there is no position left to close — the expected, SAFE outcome of
    retrying close_futures_position() after a prior attempt's response
    was lost but the close actually went through.
    """
    msg = str(exc).lower()
    return "reduceonly" in msg.replace(" ", "").replace("-", "") or "would increase" in msg or "-2022" in msg


def retry_api_call(fn: Callable, *args, max_retries: int = 3, base_delay: float = 1.0,
                    description: str = "API call", **kwargs) -> Any:
    """
    Calls fn(*args, **kwargs), retrying on a transient-looking failure with
    exponential backoff + jitter. Re-raises the last exception if every
    attempt fails. Use this for calls that are naturally idempotent to
    retry (cancels, reads) — for order-placement calls, use
    retry_algo_order() instead, which adds the duplicate-order guard.
    """
    last_err: Optional[Exception] = None
    for attempt in range(1, max_retries + 1):
        try:
            return fn(*args, **kwargs)
        except Exception as e:
            last_err = e
            if attempt >= max_retries or not _is_retryable(e):
                raise
            delay = base_delay * (2 ** (attempt - 1)) + random.uniform(0, 0.5)
            logger.warning(
                f"{description} failed (attempt {attempt}/{max_retries}): {e}. "
                f"Retrying in {delay:.1f}s…"
            )
            time.sleep(delay)
    raise last_err  # pragma: no cover — unreachable, keeps type-checkers happy


def retry_algo_order(place_fn: Callable, check_existing_fn: Callable[[], bool],
                      *, max_retries: int = 3, base_delay: float = 1.0,
                      description: str = "algo order placement") -> Any:
    """
    Places an algo order with retry, guarding against a duplicate on
    retry: before every attempt AFTER the first, calls
    `check_existing_fn()` — a zero-arg callable the caller builds to check
    whether an order of this type already exists for this symbol (e.g. via
    `algoOrders/current`) — and aborts the retry (returning None) if so,
    on the assumption the previous attempt actually succeeded server-side
    even though the response was lost.
    """
    last_err: Optional[Exception] = None
    for attempt in range(1, max_retries + 1):
        if attempt > 1:
            try:
                if check_existing_fn():
                    logger.info(
                        f"{description}: an order already exists after a prior "
                        f"attempt's response was lost — not retrying (would duplicate)."
                    )
                    return None
            except Exception as e:
                logger.warning(f"{description}: existing-order check failed ({e}); retrying anyway.")
        try:
            return place_fn()
        except Exception as e:
            last_err = e
            if attempt >= max_retries or not _is_retryable(e):
                raise
            delay = base_delay * (2 ** (attempt - 1)) + random.uniform(0, 0.5)
            logger.warning(
                f"{description} failed (attempt {attempt}/{max_retries}): {e}. "
                f"Retrying in {delay:.1f}s…"
            )
            time.sleep(delay)
    raise last_err  # pragma: no cover
</file>

<file path="pyquant_signal_math.py">
"""
pyquant_signal_math.py

Shared signal / stop-loss / take-profit / profit-target math for
pyq_p4.py, p4_utils.py and walkforward.py.

Added as part of the "Phase 0 — port walkforward's validated logic into
live" unification pass (see the PyQuant Stabilization Sprint plan doc).
walkforward.py is the project's trusted, validated reference
implementation; the constants and formulas below are extracted here so
live and walkforward can no longer drift apart from each other by
accident — a change to a shared value now has to be made once, in one
place, and is immediately visible to both.

These values reflect walkforward.py's "v4 Production Edition" validated
baseline (a 15-day walk-forward run: +276.95% return, 86.7% win rate,
Sharpe 16.73), itself the product of substantially more historical
walkforward/backtest tuning than that one run alone — NOT a single
experiment. Do not "fix" these by re-deriving them from first principles;
change walkforward.py first, confirm there, then port the change here.
"""
from __future__ import annotations

from typing import Optional

# ── Leverage ────────────────────────────────────────────────────────────────
# 10x, confirmed by extensive walkforward/backtest tuning (not an
# arbitrary live-only choice).
LEVERAGE_DEFAULT = 10

# ── ATR-adaptive stop-loss ───────────────────────────────────────────────────
# Per-symbol fixed-dollar SL delta, used when ATR is unavailable, and the
# floor beneath which the ATR-adaptive delta is never allowed to shrink.
# $225 BTC ( = 7.5 * 30 ) / $16 ETH ( = 16.0 * 1 ) fixed deltas;
# $20 BTC / $8 ETH ATR floors — exactly walkforward.py's BTC_SL_DELTA /
# ETH_SL_DELTA / BTC_SL_FLOOR / ETH_SL_FLOOR.
SL_FIXED_DELTA = {"BTC": 7.5 * 30, "ETH": 16.0 * 1}
SL_FLOOR = {"BTC": 20.0, "ETH": 8.0}
DEFAULT_ATR_MULTIPLIER = 1.8

# ── Profit-target early exit ─────────────────────────────────────────────────
# Fraction of margin-at-risk (the capital actually allocated to a trade,
# i.e. (position_size * entry_price) / leverage) at which a position is
# closed early via MARKET even though neither TP nor SL has been hit yet.
# Ported directly from walkforward.py's validated run.
PROFIT_TARGET_FRACTION = {"BTC": 0.225, "ETH": 0.175}


def symbol_key(symbol: str) -> str:
    """Normalizes any of the system's symbol spellings (BTC/USD, BTC, BTCUSDT, ...) to 'BTC' or 'ETH'."""
    s = symbol.upper()
    if "BTC" in s:
        return "BTC"
    if "ETH" in s:
        return "ETH"
    raise ValueError(f"Unknown symbol: {symbol}")


def sl_delta(symbol: str, atr: float = 0.0, atr_mult: Optional[float] = None) -> float:
    """
    The stop-loss distance (in price units) from entry for `symbol`.
    ATR-adaptive when `atr` and `atr_mult` are supplied (and atr > 0);
    otherwise the fixed-dollar delta. Matches walkforward.py's
    `sl_price()` delta calculation exactly.
    """
    key = symbol_key(symbol)
    floor = SL_FLOOR[key]
    if atr and atr > 0 and atr_mult is not None:
        return max(atr_mult * atr, floor)
    return SL_FIXED_DELTA[key]


def compute_profit(side: str, entry: float, exit_price: float, qty: float) -> float:
    """Signed PnL in quote currency. Matches walkforward.py's compute_profit()."""
    return (exit_price - entry) * qty if side.capitalize() == "Buy" else (entry - exit_price) * qty


def outcome_pct(side: str, entry_price: float, exit_price: float,
                 leverage: float = LEVERAGE_DEFAULT) -> float:
    """Signed, LEVERAGED percentage return on the capital allocated to a
    trade — e.g. 0.0183 means "+1.83%" of the margin actually at risk, not
    of the full wallet balance.

    Added 2026-10-25: SIGNAL_ONLY_MODE has no real wallet balance to diff
    a close against (Binance is geo-blocked / never called), so a
    dollar-based realized_pnl is either unavailable or, if computed
    against a stale/placeholder balance figure, meaningless — see
    pyq_p4.py's `_check_signal_only_closes()` docstring for the Oct 25
    "+$3.00 on every SL hit" incident this replaces. A plain price-return
    percentage needs no balance at all, and multiplying by leverage keeps
    it comparable to how a real leveraged account's return would look."""
    if entry_price <= 0:
        return 0.0
    raw = (exit_price - entry_price) / entry_price if side.capitalize() == "Buy" \
        else (entry_price - exit_price) / entry_price
    return raw * leverage


def margin_at_risk(position_size: float, entry_price: float, leverage: float = LEVERAGE_DEFAULT) -> float:
    """The capital actually allocated to a position: (qty * entry) / leverage."""
    if leverage <= 0:
        return 0.0
    return (position_size * entry_price) / leverage


def profit_target_threshold(symbol: str, position_size: float, entry_price: float,
                             leverage: float = LEVERAGE_DEFAULT) -> float:
    """
    The unrealized-PnL level at which `symbol`'s open position should be
    closed early (MARKET), per walkforward's validated profit-target
    rule: margin_at_risk * PROFIT_TARGET_FRACTION[symbol].
    """
    key = symbol_key(symbol)
    return margin_at_risk(position_size, entry_price, leverage) * PROFIT_TARGET_FRACTION[key]


def expected_max_loss(entry_price: float, sl_price: float, allocated_capital: float,
                       leverage: float = LEVERAGE_DEFAULT) -> float:
    """
    The dollar loss expected if SL is hit, calibrated against the capital
    actually allocated to THIS trade — not the full wallet balance at
    signal-generation time (that mismatch was Phase 0's expected_max_loss
    bug: single-signal trades allocate 80% of wallet balance and
    double-signal trades split 50/50, but the original balance-based
    figure didn't know which split would apply yet).
    """
    if entry_price <= 0:
        return 0.0
    pos_est = (allocated_capital * leverage) / entry_price
    return abs(entry_price - sl_price) * pos_est

# ══════════════════════════════════════════════════════════════════════════════

MAKER_FEE            = 0.0002
TAKER_FEE            = 0.0005
ENTRY_SLIPPAGE_PCT   = 0.0003
TP_EXIT_SLIPPAGE_PCT = 0.0004
SL_EXIT_SLIPPAGE_PCT = 0.0008
FUNDING_RATE_PER_8H  = 0.0001
MIN_NOTIONAL         = 5.0
BTC_LOT_STEP         = 0.001
ETH_LOT_STEP         = 0.001


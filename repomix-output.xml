<file path="legacy_web/live-monitor.html">
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PyQuant — Live Monitor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="./assets/style.css">
</head>
<body>
<div class="app-shell">
  <header class="topbar">
    <div class="brand">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 17L9 11L13 15L21 7" stroke="#5B8DEF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 7H21V13" stroke="#5B8DEF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="name">PyQuant</span>
      <span class="subtitle">Control Center</span>
    </div>
    <div class="mode-switch" id="mode-switch"></div>
  </header>
  <nav class="primary">
    <a href="index.html">Dashboard</a>
    <a href="live-monitor.html">Live Monitor</a>
    <a href="signals.html">Signals</a>
    <a href="backtest.html">Backtest</a>
    <a href="compare.html">Compare</a>
    <a href="settings.html">API Keys &amp; Settings</a>
  </nav>
  <main>
    <div id="banner-slot"></div>
    <div class="card" id="heartbeat-card" style="margin-bottom:16px;">
      <h3>Engine Heartbeat</h3>
      <div class="stat-label" id="heartbeat-text">Checking…</div>
      <div class="stat-label" id="ukf-retrain-text" style="margin-top:8px;">Checking…</div>
    </div>
    <div class="card" style="margin-bottom:16px;">
      <h3>Signal Diagnostics (last hourly tick, each symbol)</h3>
      <table id="tbl-diag">
        <thead>
          <tr>
            <th>Symbol</th><th>Trend</th><th>Price</th><th>Predicted</th>
            <th>% Move</th><th>Vol Gate</th><th>Entry Gate</th><th>Fired?</th><th>As of</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
      <div class="empty-state" id="empty-diag" style="display:none;">
        No diagnostic recorded yet — either the engine hasn't ticked since
        this panel was added, or hourly_task() hasn't run yet. Check the
        Engine Heartbeat above and the GitHub Actions run history.
      </div>
      <div class="hint" style="margin-top:8px;font-size:12px;color:var(--text-faint);">
        "Vol Gate" and "Entry Gate" show the raw comparison the strategy
        makes every hour, whether or not it clears — a quiet stretch with
        both gates consistently missing by a small margin is the strategy
        correctly waiting for a bigger move, not a stuck/disconnected
        engine. Mechanics are identical to the validated walkforward.py
        backtest (see SPEC.md/DOCS.md) — nothing here is a reduced or
        temporary version of the real signal logic.
      </div>
    </div>
    <div class="card">
      <h3>Currently Open Positions</h3>
      <table id="tbl-live">
        <thead>
          <tr>
            <th>Symbol</th><th>Side</th><th>Entry</th><th>SL</th><th>TP</th>
            <th>Qty</th><th>Capital</th><th>Max Loss</th><th>Mode</th><th>Opened</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
      <div class="empty-state" id="empty-live" style="display:none;">
        No open positions. The last hourly cycle generated no entry, or trading is currently OFF.
      </div>
    </div>
  </main>
  <footer class="hint">Reflects pyquant_state's signals log as of the last entry/close the trading engine wrote. Refresh the page for the latest.</footer>
</div>
<script src="./assets/app.js"></script>
<script>
function fmtPct(v) {
  if (v === null || v === undefined) return "—";
  return (Number(v) * 100).toFixed(3) + "%";
}

async function loadHeartbeat() {
  const hbText = document.getElementById("heartbeat-text");
  const diagBody = document.querySelector("#tbl-diag tbody");
  try {
    const h = await apiGet("/heartbeat");
    const age = h.cron_age_seconds;
    if (age === null || age === undefined) {
      hbText.innerHTML = `<span style="color:var(--text-faint);">No cron tick recorded yet — either the engine hasn't run since this was added, or it isn't running. Check the GitHub Actions run history.</span>`;
    } else {
      const mins = Math.floor(age / 60);
      hbText.innerHTML = age < 360
        ? `<span style="color:#3ddc84;">● Live</span> — last tick ${mins < 1 ? 'under a minute' : mins + ' min'} ago`
        : age < 900
          ? `<span style="color:#f5a623;">● Stale</span> — last tick ${mins} min ago (expected every ~5 min)`
          : `<span style="color:#e5484d;">● Not reporting</span> — last tick ${mins} min ago. Check the GitHub Actions run history.`;
    }

    // 2026-10-27: separate from the 5-min cron heartbeat above — this is
    // specifically "did the once-daily 1H UKF re-anchor actually happen
    // today", added after a live incident where a slow parameter search
    // timed out the job before the re-anchor ran, silently stalling
    // signal generation for days with nothing in the UI pointing at why.
    const ukfEl = document.getElementById("ukf-retrain-text");
    const ukf = h.ukf_retrain;
    const ukfAge = h.ukf_retrain_age_seconds;
    if (!ukf || ukfAge === null || ukfAge === undefined) {
      ukfEl.innerHTML = `<span style="color:var(--text-faint);">UKF re-anchor: no record yet — either this hasn't shipped to this deployment yet, or it hasn't ticked since.</span>`;
    } else {
      const hrs = (ukfAge / 3600).toFixed(1);
      if (ukf.status === "failed") {
        ukfEl.innerHTML = `<span style="color:#e5484d;">● UKF re-anchor FAILED</span> ${hrs}h ago: ${ukf.error || "unknown error"}`;
      } else if (ukfAge > 36 * 3600) {
        ukfEl.innerHTML = `<span style="color:#e5484d;">● UKF re-anchor overdue</span> — last success ${hrs}h ago (expected daily). Check GitHub Actions run history.`;
      } else {
        ukfEl.innerHTML = `<span style="color:#3ddc84;">● UKF re-anchored</span> ${hrs}h ago`;
      }
    }

    const diag = h.signal_diagnostics || {};
    const symbols = Object.keys(diag);
    if (symbols.length === 0) {
      document.getElementById("empty-diag").style.display = "block";
    } else {
      diagBody.innerHTML = symbols.map(sym => {
        const dg = diag[sym];
        const volGate = dg.vol_gate_passed === undefined ? "—"
          : (dg.vol_gate_passed ? `<span style="color:#3ddc84;">pass</span>` : `<span style="color:#f5a623;">miss</span>`)
            + ` (${fmtPct(dg.pct_diff)} / ${fmtPct(dg.vol)} vs ${fmtPct(dg.vol_gate_threshold)})`;
        const entryGate = dg.strict_gate_passed === undefined ? "—"
          : (dg.strict_gate_passed ? `<span style="color:#3ddc84;">pass</span>` : `<span style="color:#f5a623;">miss</span>`)
            + ` (${fmtPct(dg.strict_diff)} vs ${fmtPct(dg.strict_threshold)})`;
        return `
        <tr>
          <td class="mono">${sym}</td>
          <td>${dg.trend ?? "flat"}</td>
          <td class="mono">${fmtPrice(dg.price)}</td>
          <td class="mono">${fmtPrice(dg.pred)}</td>
          <td class="mono">${dg.pct_diff !== undefined ? fmtPct(dg.pct_diff) : "—"}</td>
          <td>${volGate}</td>
          <td>${entryGate}</td>
          <td>${dg.signal_fired ? "YES" : (dg.stage_reached === "exception" ? `error: ${dg.error ?? ''}` : "no")}</td>
          <td>${fmtTime(dg.ts)}</td>
        </tr>`;
      }).join("");
    }
  } catch (e) {
    hbText.innerHTML = `<span style="color:#e5484d;">Could not reach the API (${e.message}).</span>`;
  }
}
loadHeartbeat();

async function loadLive() {
  const bannerSlot = document.getElementById("banner-slot");
  try {
    const d = await apiGet("/signals/open");
    const body = document.querySelector("#tbl-live tbody");
    if (d.signals.length === 0) {
      document.getElementById("empty-live").style.display = "block";
      return;
    }
    body.innerHTML = d.signals.map(s => `
      <tr>
        <td class="mono">${s.symbol}</td>
        <td class="${s.side === 'BUY' ? 'side-buy' : 'side-sell'}">${s.side}</td>
        <td class="mono">${fmtPrice(s.entry_price)}</td>
        <td class="mono">${fmtPrice(s.sl_price)}</td>
        <td class="mono">${fmtPrice(s.tp_price)}</td>
        <td class="mono">${s.qty ?? "—"}</td>
        <td class="mono">${fmtMoney(s.entry_capital)}</td>
        <td class="mono">${fmtMoney(s.expected_max_loss)}</td>
        <td>${s.mode}</td>
        <td>${fmtTime(s.opened_at)}</td>
      </tr>`).join("");
  } catch (e) {
    bannerSlot.innerHTML = `<div class="banner error">Could not reach the API (${e.message}).</div>`;
  }
}
loadLive();
</script>

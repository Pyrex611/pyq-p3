import { useEffect, useMemo, useState } from "react";
import Layout from "../components/Layout";
import { apiGet, fmtMoney, fmtPct, fmtPrice, fmtTime, pnlClass, statusLabel, rawPct } from "../lib/api";

// Mirrors pyquant_signal_math.LEVERAGE_DEFAULT (10) — every stored
// realized_pnl_pct value was computed with exactly this leverage baked
// in (pyq_p4.py's _check_signal_only_closes() calls outcome_pct() with
// no explicit leverage arg, so it always uses this default — confirmed
// by reading that call site directly, not assumed). Hardcoded here
// rather than fetched: it's a stable, rarely-changed constant, and
// adding a round trip just to read one number isn't worth it. If it's
// ever changed in pyquant_signal_math.py, update this too.
const SYSTEM_LEVERAGE = 10;

export default function Dashboard() {
  const [data, setData] = useState(null);
  const [error, setError] = useState(null);
  const [leverageInput, setLeverageInput] = useState("");

  useEffect(() => {
    let cancelled = false;
    apiGet("/dashboard")
      .then((d) => { if (!cancelled) setData(d); })
      .catch((e) => { if (!cancelled) setError(e.message); });
    return () => { cancelled = true; };
  }, []);

  const lev = (() => {
    const v = parseFloat(leverageInput);
    return v && v > 0 ? v : SYSTEM_LEVERAGE;
  })();
  const usingOverride = lev !== SYSTEM_LEVERAGE;

  const heartbeat = useMemo(() => {
    if (!data) return null;
    const age = data.cron_age_seconds;
    if (age === null || age === undefined) {
      return {
        color: "var(--text-faint)",
        text: "No cron tick recorded yet — either the engine hasn't run since this field was added, or it isn't running. Check the GitHub Actions run history.",
      };
    }
    const mins = Math.floor(age / 60);
    if (age < 360) {
      return { color: "#3ddc84", text: `● Live — last tick ${mins < 1 ? "under a minute" : mins + " min"} ago` };
    }
    if (age < 900) {
      return { color: "#f5a623", text: `● Stale — last tick ${mins} min ago (expected every ~5 min)` };
    }
    return { color: "#e5484d", text: `● Not reporting — last tick ${mins} min ago. Check the GitHub Actions run history.` };
  }, [data]);

  // Recomputed (if a leverage override is active) from the SAME rows the
  // backend's avg_pnl_pct_recent covers — but only the ones also
  // returned in recent_closed (10 of up to 200), since that's all this
  // page has entry/outcome prices for. Labeled accordingly so the scope
  // difference is never silently hidden.
  const closedWithPct = useMemo(() => {
    if (!data) return [];
    return data.recent_closed
      .map((s) => rawPct(s.side, s.entry_price, s.outcome_price))
      .filter((v) => v !== null);
  }, [data]);
  const avgRaw = closedWithPct.length
    ? closedWithPct.reduce((a, b) => a + b, 0) / closedWithPct.length
    : null;
  const avgLeveraged = avgRaw !== null ? avgRaw * lev : null;

  let pnlValue = "—", pnlLabel = "last 200 logged signals", pnlCls = "";
  if (data) {
    if (usingOverride && avgLeveraged !== null) {
      pnlValue = fmtPct(avgLeveraged);
      pnlCls = pnlClass(avgLeveraged);
      pnlLabel = `at ${lev}× leverage, last ${closedWithPct.length} shown below`;
    } else if (data.avg_pnl_pct_recent !== null && data.avg_pnl_pct_recent !== undefined) {
      pnlValue = fmtPct(data.avg_pnl_pct_recent);
      pnlCls = pnlClass(data.avg_pnl_pct_recent);
      pnlLabel = `avg. leveraged return (${SYSTEM_LEVERAGE}×), last 200 logged signals`;
    } else {
      pnlValue = fmtMoney(data.realized_pnl_recent);
      pnlCls = pnlClass(data.realized_pnl_recent);
      pnlLabel = "last 200 logged signals (USD — no % data yet)";
    }
  }

  return (
    <Layout title="Dashboard" footer="Data refreshes on page load. Trading toggle takes effect on the next scheduled hourly cycle.">
      {error && (
        <div className="banner error">
          Could not reach the API ({error}). Check that the backend is deployed and PYQUANT_API_BASE / the /api rewrite is configured.
        </div>
      )}

      <div className="card" style={{ marginBottom: 16 }}>
        <h3>Engine Heartbeat</h3>
        <div className="stat-label" style={heartbeat ? { color: heartbeat.color } : undefined}>
          {heartbeat ? heartbeat.text : "Checking…"}
        </div>
      </div>

      <div className="card" style={{ marginBottom: 16 }}>
        <h3>Leverage</h3>
        <label>
          Leverage ×<br />
          <input
            type="number" min="1" step="0.5" placeholder="10" style={{ width: 90 }}
            value={leverageInput}
            onChange={(e) => setLeverageInput(e.target.value)}
          />
        </label>
        <button type="button" className="btn" style={{ marginLeft: 8 }} onClick={() => setLeverageInput("")}>
          Reset to system default
        </button>
      </div>

      <div className="grid cols-4" style={{ marginBottom: 16 }}>
        <div className="card">
          <h3>Open Positions</h3>
          <div className="stat-value">{data ? data.open_positions.length : "—"}</div>
          <div className="stat-label">currently monitored</div>
        </div>
        <div className="card">
          <h3>Avg. Return (recent)</h3>
          <div className={`stat-value ${pnlCls}`}>{pnlValue}</div>
          <div className="stat-label">{pnlLabel}</div>
        </div>
        <div className="card">
          <h3>Trading</h3>
          <div className="stat-value">{data ? (data.trading_enabled ? "ON" : "OFF") : "—"}</div>
          <div className="stat-label">{data ? `${data.mode.toUpperCase()} mode` : "—"}</div>
        </div>
        <div className="card">
          <h3>Last Run</h3>
          <div className="stat-value">{data && data.last_run ? data.last_run.run_type : "—"}</div>
          <div className="stat-label">
            {data && data.last_run ? fmtTime(data.last_run.finished_at) : "no runs logged yet"}
          </div>
        </div>
      </div>

      <div className="grid cols-2">
        <div className="card">
          <h3>Open Positions</h3>
          <table>
            <thead>
              <tr><th>Symbol</th><th>Side</th><th>Entry</th><th>SL</th><th>TP</th><th>Opened</th></tr>
            </thead>
            <tbody>
              {data && data.open_positions.map((s, i) => (
                <tr key={i}>
                  <td className="mono">{s.symbol}</td>
                  <td className={s.side === "BUY" ? "side-buy" : "side-sell"}>{s.side}</td>
                  <td className="mono">{fmtPrice(s.entry_price)}</td>
                  <td className="mono">{fmtPrice(s.sl_price)}</td>
                  <td className="mono">{fmtPrice(s.tp_price)}</td>
                  <td>{fmtTime(s.opened_at)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {data && data.open_positions.length === 0 && (
            <div className="empty-state">No open positions right now.</div>
          )}
        </div>
        <div className="card">
          <h3>Recently Closed</h3>
          <table>
            <thead>
              <tr><th>Symbol</th><th>Side</th><th>Outcome</th><th>PnL</th><th>Closed</th></tr>
            </thead>
            <tbody>
              {data && data.recent_closed.map((s, i) => {
                const raw = rawPct(s.side, s.entry_price, s.outcome_price);
                const displayPct = usingOverride && raw !== null
                  ? raw * lev
                  : (s.realized_pnl_pct !== null && s.realized_pnl_pct !== undefined ? s.realized_pnl_pct : null);
                return (
                  <tr key={i}>
                    <td className="mono">{s.symbol}</td>
                    <td className={s.side === "BUY" ? "side-buy" : "side-sell"}>{s.side}</td>
                    <td><span className={`pill ${s.status}`}>{statusLabel(s.status)}</span></td>
                    <td className={pnlClass(displayPct ?? s.realized_pnl)}>
                      {displayPct !== null ? fmtPct(displayPct) : fmtMoney(s.realized_pnl)}
                    </td>
                    <td>{fmtTime(s.closed_at)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          {data && data.recent_closed.length === 0 && (
            <div className="empty-state">No closed signals logged yet.</div>
          )}
        </div>
      </div>
    </Layout>
  );
}
</file>

<file path="pages/live-monitor.js">
import { useEffect, useState } from "react";
import Layout from "../components/Layout";
import { apiGet, fmtPrice, fmtTime, fmtMoney } from "../lib/api";

// live-monitor.html's inline script locally redefined fmtPct with
// different precision/no sign (3 decimals, raw) from the shared
// app.js/lib/api.js version (2 decimals, signed) — kept as its own
// function here too, scoped to this page only, exactly like the
// original.
function fmtDiagPct(v) {
  if (v === null || v === undefined) return "—";
  return (Number(v) * 100).toFixed(3) + "%";
}

export default function LiveMonitor() {
  const [heartbeat, setHeartbeat] = useState(null);
  const [hbError, setHbError] = useState(null);
  const [live, setLive] = useState(null);
  const [liveError, setLiveError] = useState(null);

  useEffect(() => {
    let cancelled = false;
    apiGet("/heartbeat")
      .then((h) => { if (!cancelled) setHeartbeat(h); })
      .catch((e) => { if (!cancelled) setHbError(e.message); });
    apiGet("/signals/open")
      .then((d) => { if (!cancelled) setLive(d); })
      .catch((e) => { if (!cancelled) setLiveError(e.message); });
    return () => { cancelled = true; };
  }, []);

  let hbLine = { color: null, text: "Checking…" };
  if (hbError) {
    hbLine = { color: "#e5484d", text: `Could not reach the API (${hbError}).` };
  } else if (heartbeat) {
    const age = heartbeat.cron_age_seconds;
    if (age === null || age === undefined) {
      hbLine = {
        color: "var(--text-faint)",
        text: "No cron tick recorded yet — either the engine hasn't run since this was added, or it isn't running. Check the GitHub Actions run history.",
      };
    } else {
      const mins = Math.floor(age / 60);
      if (age < 360) hbLine = { color: "#3ddc84", text: `● Live — last tick ${mins < 1 ? "under a minute" : mins + " min"} ago` };
      else if (age < 900) hbLine = { color: "#f5a623", text: `● Stale — last tick ${mins} min ago (expected every ~5 min)` };
      else hbLine = { color: "#e5484d", text: `● Not reporting — last tick ${mins} min ago. Check the GitHub Actions run history.` };
    }
  }

  // 2026-10-27: separate from the 5-min cron heartbeat above — specifically
  // "did the once-daily 1H UKF re-anchor actually happen today", added
  // after a live incident where a slow parameter search timed out the job
  // before the re-anchor ran, silently stalling signal generation for days
  // with nothing in the UI pointing at why.
  let ukfLine = { color: null, text: "Checking…" };
  if (heartbeat) {
    const ukf = heartbeat.ukf_retrain;
    const ukfAge = heartbeat.ukf_retrain_age_seconds;
    if (!ukf || ukfAge === null || ukfAge === undefined) {
      ukfLine = {
        color: "var(--text-faint)",
        text: "UKF re-anchor: no record yet — either this hasn't shipped to this deployment yet, or it hasn't ticked since.",
      };
    } else {
      const hrs = (ukfAge / 3600).toFixed(1);
      if (ukf.status === "failed") {
        ukfLine = { color: "#e5484d", text: `● UKF re-anchor FAILED ${hrs}h ago: ${ukf.error || "unknown error"}` };
      } else if (ukfAge > 36 * 3600) {
        ukfLine = { color: "#e5484d", text: `● UKF re-anchor overdue — last success ${hrs}h ago (expected daily). Check GitHub Actions run history.` };
      } else {
        ukfLine = { color: "#3ddc84", text: `● UKF re-anchored ${hrs}h ago` };
      }
    }
  }

  const diag = (heartbeat && heartbeat.signal_diagnostics) || {};
  const symbols = Object.keys(diag);

  return (
    <Layout title="Live Monitor" footer="Reflects pyquant_state's signals log as of the last entry/close the trading engine wrote. Refresh the page for the latest.">
      <div className="card" style={{ marginBottom: 16 }}>
        <h3>Engine Heartbeat</h3>
        <div className="stat-label" style={hbLine.color ? { color: hbLine.color } : undefined}>{hbLine.text}</div>
        <div className="stat-label" style={{ marginTop: 8, ...(ukfLine.color ? { color: ukfLine.color } : {}) }}>{ukfLine.text}</div>
      </div>

      <div className="card" style={{ marginBottom: 16 }}>
        <h3>Signal Diagnostics (last hourly tick, each symbol)</h3>
        <table>
          <thead>
            <tr>
              <th>Symbol</th><th>Trend</th><th>Price</th><th>Predicted</th>
              <th>% Move</th><th>Vol Gate</th><th>Entry Gate</th><th>Fired?</th><th>As of</th>
            </tr>
          </thead>
          <tbody>
            {symbols.map((sym) => {
              const dg = diag[sym];
              const volGate = dg.vol_gate_passed === undefined
                ? "—"
                : (
                  <>
                    <span style={{ color: dg.vol_gate_passed ? "#3ddc84" : "#f5a623" }}>
                      {dg.vol_gate_passed ? "pass" : "miss"}
                    </span>
                    {` (${fmtDiagPct(dg.pct_diff)} / ${fmtDiagPct(dg.vol)} vs ${fmtDiagPct(dg.vol_gate_threshold)})`}
                  </>
                );
              const entryGate = dg.strict_gate_passed === undefined
                ? "—"
                : (
                  <>
                    <span style={{ color: dg.strict_gate_passed ? "#3ddc84" : "#f5a623" }}>
                      {dg.strict_gate_passed ? "pass" : "miss"}
                    </span>
                    {` (${fmtDiagPct(dg.strict_diff)} vs ${fmtDiagPct(dg.strict_threshold)})`}
                  </>
                );
              return (
                <tr key={sym}>
                  <td className="mono">{sym}</td>
                  <td>{dg.trend ?? "flat"}</td>
                  <td className="mono">{fmtPrice(dg.price)}</td>
                  <td className="mono">{fmtPrice(dg.pred)}</td>
                  <td className="mono">{dg.pct_diff !== undefined ? fmtDiagPct(dg.pct_diff) : "—"}</td>
                  <td>{volGate}</td>
                  <td>{entryGate}</td>
                  <td>{dg.signal_fired ? "YES" : (dg.stage_reached === "exception" ? `error: ${dg.error ?? ""}` : "no")}</td>
                  <td>{fmtTime(dg.ts)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        {heartbeat && symbols.length === 0 && (
          <div className="empty-state">
            No diagnostic recorded yet — either the engine hasn't ticked since this panel was added, or
            hourly_task() hasn't run yet. Check the Engine Heartbeat above and the GitHub Actions run history.
          </div>
        )}
        <div className="hint" style={{ marginTop: 8, fontSize: 12, color: "var(--text-faint)" }}>
          &quot;Vol Gate&quot; and &quot;Entry Gate&quot; show the raw comparison the strategy makes every
          hour, whether or not it clears — a quiet stretch with both gates consistently missing by a small
          margin is the strategy correctly waiting for a bigger move, not a stuck/disconnected engine.
          Mechanics are identical to the validated walkforward.py backtest (see SPEC.md/DOCS.md) — nothing
          here is a reduced or temporary version of the real signal logic.
        </div>
      </div>

      <div className="card">
        <h3>Currently Open Positions</h3>
        {liveError ? (
          <div className="banner error">Could not reach the API ({liveError}).</div>
        ) : (
          <>
            <table>
              <thead>
                <tr>
                  <th>Symbol</th><th>Side</th><th>Entry</th><th>SL</th><th>TP</th>
                  <th>Qty</th><th>Capital</th><th>Max Loss</th><th>Mode</th><th>Opened</th>
                </tr>
              </thead>
              <tbody>
                {live && live.signals.map((s, i) => (
                  <tr key={i}>
                    <td className="mono">{s.symbol}</td>
                    <td className={s.side === "BUY" ? "side-buy" : "side-sell"}>{s.side}</td>
                    <td className="mono">{fmtPrice(s.entry_price)}</td>
                    <td className="mono">{fmtPrice(s.sl_price)}</td>
                    <td className="mono">{fmtPrice(s.tp_price)}</td>
                    <td className="mono">{s.qty ?? "—"}</td>
                    <td className="mono">{fmtMoney(s.entry_capital)}</td>
                    <td className="mono">{fmtMoney(s.expected_max_loss)}</td>
                    <td>{s.mode}</td>
                    <td>{fmtTime(s.opened_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {live && live.signals.length === 0 && (
              <div className="empty-state">No open positions. The last hourly cycle generated no entry, or trading is currently OFF.</div>
            )}
          </>
        )}
      </div>
    </Layout>
  );
}
</file>

<file path="pages/settings.js">
import { useEffect, useState } from "react";
import Layout from "../components/Layout";
import { apiGet, apiPost, fmtTime } from "../lib/api";

const EXCHANGE_KEYS = [
  ["ALPACA_API_KEY", "Alpaca API Key"],
  ["ALPACA_SECRET_KEY", "Alpaca Secret Key"],
  ["BYBIT_API_KEY", "Bybit API Key"],
  ["BYBIT_SECRET_KEY", "Bybit Secret Key"],
  ["BINANCE_API_KEY", "Binance API Key (mainnet)"],
  ["BINANCE_SECRET_KEY", "Binance Secret Key (mainnet)"],
  ["BINANCE_TESTNET_API_KEY", "Binance API Key (testnet / paper)"],
  ["BINANCE_TESTNET_SECRET_KEY", "Binance Secret Key (testnet / paper)"],
];
const OTHER_KEYS = [
  ["TELEGRAM_TOKEN", "Telegram Bot Token"],
  ["TELEGRAM_CHAT_ID", "Telegram Chat ID"],
  ["DATABASE_URL", "Postgres DATABASE_URL"],
];

function ConfigRows({ cfg, keys }) {
  return keys.map(([key, label]) => {
    const set = !!(cfg && cfg[key]);
    return (
      <div className="config-row" key={key}>
        <span className="config-key">
          <span className={`dot ${set ? "set" : "unset"}`}></span>{label}
        </span>
        <span className="mono" style={{ color: set ? "var(--green)" : "var(--text-faint)", fontSize: 12 }}>
          {set ? "CONFIGURED" : "NOT SET"}
        </span>
      </div>
    );
  });
}

export default function Settings() {
  const [cfg, setCfg] = useState(null);
  const [cfgError, setCfgError] = useState(null);
  const [baseline, setBaseline] = useState(undefined); // undefined = loading, null = no baseline, string = set
  const [baselineError, setBaselineError] = useState(null);

  async function loadBaseline() {
    try {
      const d = await apiGet("/signals/baseline");
      setBaseline(d.reset_at);
      setBaselineError(null);
    } catch (e) {
      setBaselineError(e.message);
    }
  }

  useEffect(() => {
    apiGet("/config").then(setCfg).catch((e) => setCfgError(e.message));
    loadBaseline();
  }, []);

  async function resetBaseline() {
    if (!confirm("Dashboard figures will only count signals opened from this moment on. Continue?")) return;
    try {
      await apiPost("/signals/baseline/reset", {});
      await loadBaseline();
    } catch (e) {
      alert("Could not reset the baseline: " + e.message);
    }
  }

  async function clearBaseline() {
    try {
      await apiPost("/signals/baseline/clear", {});
      await loadBaseline();
    } catch (e) {
      alert("Could not clear the baseline: " + e.message);
    }
  }

  return (
    <Layout
      title="API Keys & Settings"
      footer="To rotate a key, update it in the Vercel dashboard (or the orchestra VPS's .env for the trading engine itself) and redeploy/restart — this page is read-only."
    >
      <div className="banner warn">
        This screen shows whether a credential is configured in the API&apos;s own Vercel environment — never
        the actual values. Keys are managed in the Vercel project&apos;s Environment Variables, not here.
      </div>
      {cfgError && <div className="banner error">Could not reach the API ({cfgError}).</div>}

      <div className="grid cols-2">
        <div className="card">
          <h3>Exchange &amp; Data Credentials</h3>
          <div><ConfigRows cfg={cfg} keys={EXCHANGE_KEYS} /></div>
        </div>
        <div className="card">
          <h3>Notifications &amp; Persistence</h3>
          <div><ConfigRows cfg={cfg} keys={OTHER_KEYS} /></div>
        </div>
      </div>

      <div className="card" style={{ marginTop: 16 }}>
        <h3>Signals Baseline (&quot;Fresh Start&quot;)</h3>
        <p className="hint" style={{ marginTop: -4 }}>
          The Dashboard&apos;s figures (open positions, recently closed, avg. return) only count signals opened
          on or after this timestamp. Nothing is deleted — the Signals and Compare pages always show full
          history regardless. Use this after a change to the tracking/PnL logic makes older numbers not
          comparable to new ones (e.g. the 2026-10-25 TP/SL-tracking fix).
        </p>
        <div className="mono" style={{ fontSize: 13, marginBottom: 10 }}>
          {baselineError
            ? `Could not load (${baselineError}).`
            : baseline === undefined
              ? "Checking…"
              : baseline
                ? `Counting signals opened on/after ${fmtTime(baseline)}.`
                : "No baseline set — counting all signals (original behavior)."}
        </div>
        <button type="button" className="btn primary" onClick={resetBaseline}>Start Fresh From Now</button>
        <button type="button" className="btn" style={{ marginLeft: 8 }} onClick={clearBaseline}>Clear (count everything again)</button>
      </div>
    </Layout>
  );
}
</file>


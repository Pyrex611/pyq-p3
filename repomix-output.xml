/* PyQuant Control Center — shared stylesheet
   Color tokens matched to the approved Design-canvas mockup
   (Main.dc.html / LiveMonitor.dc.html / Signals.dc.html / Backtest.dc.html /
   ApiKeys.dc.html) so this deployable frontend reads as the same product,
   not a re-skin. This file is hand-written, separate production CSS — the
   mockup's own .dc.html files are a Claude-hosted design reference, not
   something this frontend imports or extends. */

:root {
  --bg: #0B0D11;
  --bg-panel: #12151A;
  --border: #242933;
  --border-soft: #171B22;
  --text: #E7E9ED;
  --text-dim: #C9CDD4;
  --text-muted: #8A909C;
  --text-faint: #565C68;
  --accent: #5B8DEF;
  --accent-soft: #2C3B5C;
  --accent-soft-text: #BBD0FF;
  --green: #3FB950;
  --red: #F2545B;
  --amber: #E3A13A;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
}

.mono { font-family: 'IBM Plex Mono', monospace; }

a { color: var(--accent); text-decoration: none; }
a:hover { color: #7fa4f3; }

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

table { border-collapse: collapse; width: 100%; }
th, td { text-align: left; padding: 10px 12px; font-size: 13px; }
th {
  color: var(--text-faint); font-weight: 500; text-transform: uppercase;
  letter-spacing: 0.04em; font-size: 11px; border-bottom: 1px solid var(--border);
}
td { border-bottom: 1px solid var(--border-soft); color: var(--text-dim); }
tbody tr:hover td { background: #0E1116; }

.app-shell {
  min-height: 100vh; width: 100%; max-width: 1440px; margin: 0 auto;
  display: flex; flex-direction: column; background: var(--bg);
}

.topbar {
  height: 64px; flex: 0 0 auto; display: flex; align-items: center;
  justify-content: space-between; padding: 0 24px; border-bottom: 1px solid var(--border);
  background: var(--bg); position: sticky; top: 0; z-index: 10;
}

.brand { display: flex; align-items: center; gap: 10px; }
.brand .name { font-weight: 600; font-size: 15px; letter-spacing: 0.01em; }
.brand .subtitle { color: var(--text-faint); font-size: 13px; margin-left: 2px; }

.mode-switch {
  display: flex; gap: 4px; background: var(--bg-panel); border: 1px solid var(--border);
  border-radius: 8px; padding: 3px;
}
.mode-switch button {
  font-family: inherit; font-size: 12px; font-weight: 600; letter-spacing: 0.04em;
  padding: 6px 14px; border-radius: 6px; border: none; background: transparent;
  color: var(--text-muted); cursor: pointer; transition: background .12s, color .12s;
}
.mode-switch button.active { background: var(--accent-soft); color: var(--accent-soft-text); }
.mode-switch button.off.active { background: #4a2328; color: #ffb3b8; }

nav.primary { display: flex; gap: 20px; padding: 0 24px; border-bottom: 1px solid var(--border); }
nav.primary a {
  display: inline-block; padding: 12px 2px; font-size: 13px; color: var(--text-muted);
  border-bottom: 2px solid transparent;
}
nav.primary a:hover { color: var(--text); }
nav.primary a.active { color: var(--text); border-bottom-color: var(--accent); }

main { padding: 24px; flex: 1 1 auto; }

.grid { display: grid; gap: 16px; }
.cols-2 { grid-template-columns: repeat(2, 1fr); }
.cols-3 { grid-template-columns: repeat(3, 1fr); }
.cols-4 { grid-template-columns: repeat(4, 1fr); }
@media (max-width: 900px) {
  .cols-2, .cols-3, .cols-4 { grid-template-columns: 1fr; }
}

.card {
  background: var(--bg-panel); border: 1px solid var(--border); border-radius: 10px;
  padding: 18px 20px;
}
.card h3 {
  margin: 0 0 14px 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-faint); font-weight: 600;
}

.stat-value { font-size: 26px; font-weight: 600; }
.stat-label { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

.pill {
  display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11px;
  font-weight: 600; letter-spacing: 0.02em;
}
.pill.open { background: #1c2f52; color: #8fb4ff; }
.pill.closed_tp { background: #113524; color: #6fd99a; }
.pill.closed_sl { background: #40201f; color: #ff9a92; }
.pill.closed_manual { background: #2a2a1f; color: #e0d27a; }

.side-buy { color: var(--green); }
.side-sell { color: var(--red); }
.pnl-pos { color: var(--green); }
.pnl-neg { color: var(--red); }

.empty-state { color: var(--text-muted); font-size: 13px; padding: 24px; text-align: center; }

.config-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 11px 0; border-bottom: 1px solid var(--border-soft);
}
.config-row:last-child { border-bottom: none; }
.config-key { font-size: 13px; color: var(--text-dim); }
.dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 8px; }
.dot.set { background: var(--green); }
.dot.unset { background: var(--text-faint); }

.banner {
  padding: 10px 16px; border-radius: 8px; font-size: 13px; margin-bottom: 16px;
  display: flex; align-items: center; gap: 10px;
}
.banner.warn { background: #3a2a14; color: #e3b96a; border: 1px solid #5a4322; }
.banner.error { background: #3a1416; color: #ff9a92; border: 1px solid #5a2224; }

footer.hint { padding: 16px 24px; color: var(--text-faint); font-size: 12px; }

/* 2026-10-26: minimal generic button, scoped to not disturb any existing
   unstyled <button> (form inputs opt in explicitly where used). */
button.btn {
  font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: 0.01em;
  padding: 8px 16px; border-radius: 8px; border: 1px solid var(--border);
  background: var(--bg-panel); color: var(--text); cursor: pointer;
  transition: background .12s, border-color .12s;
}
button.btn:hover { background: #171B22; border-color: var(--accent); }
button.btn.primary { background: var(--accent-soft); border-color: var(--accent-soft); color: var(--accent-soft-text); }
button.btn.primary:hover { border-color: var(--accent); }

/* Run-detail modal (Backtest page) — 2026-10-26 */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(5, 6, 9, 0.72);
  display: flex; align-items: flex-start; justify-content: center;
  padding: 48px 16px; z-index: 100; overflow-y: auto;
}
.modal-overlay.hidden { display: none; }
.modal-card {
  background: var(--bg-panel); border: 1px solid var(--border); border-radius: 12px;
  width: 100%; max-width: 640px; padding: 22px 24px; position: relative;
}
.modal-card h3 { margin: 0 0 4px 0; font-size: 15px; color: var(--text); }
.modal-card .modal-sub { font-size: 12px; color: var(--text-muted); margin-bottom: 16px; }
.modal-close {
  position: absolute; top: 16px; right: 18px; background: none; border: none;
  color: var(--text-muted); font-size: 20px; line-height: 1; cursor: pointer;
}
.modal-close:hover { color: var(--text); }
.modal-section { margin-bottom: 16px; }
.modal-section h4 {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-faint); margin: 0 0 8px 0; font-weight: 600;
}
.kv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; }
.kv-grid .kv-row { display: flex; justify-content: space-between; font-size: 13px; padding: 4px 0; border-bottom: 1px solid var(--border-soft); }
.kv-grid .kv-key { color: var(--text-muted); }
.kv-grid .kv-val { color: var(--text-dim); font-family: 'IBM Plex Mono', monospace; }
.modal-error { color: #ff9a92; font-size: 13px; white-space: pre-wrap; font-family: 'IBM Plex Mono', monospace; }
</file>

<file path="legacy_web/backtest.html">
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PyQuant — Backtest</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="./assets/style.css">
</head>
<body>
<div class="app-shell">
  <header class="topbar">
    <div class="brand">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 17L9 11L13 15L21 7" stroke="#5B8DEF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 7H21V13" stroke="#5B8DEF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="name">PyQuant</span>
      <span class="subtitle">Control Center</span>
    </div>
    <div class="mode-switch" id="mode-switch"></div>
  </header>
  <nav class="primary">
    <a href="index.html">Dashboard</a>
    <a href="live-monitor.html">Live Monitor</a>
    <a href="signals.html">Signals</a>
    <a href="backtest.html">Backtest</a>
    <a href="compare.html">Compare</a>
    <a href="settings.html">API Keys &amp; Settings</a>
  </nav>
  <main>
    <div id="banner-slot"></div>
    <div class="card" style="margin-bottom:16px;">
      <h3>Run a new backtest</h3>
      <p class="hint" style="margin-top:-4px;">
        "Run Backtest" starts the same walkforward logic as an automated
        GitHub Actions job — no manual step, result syncs back here
        automatically.
      </p>
      <form id="backtest-form" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
        <label>Days<br><input type="number" name="walk_forward_days" placeholder="15" min="1" style="width:80px;"></label>
        <label>Bayesian trials<br><input type="number" name="bayesian_trials" placeholder="150" min="1" style="width:90px;"></label>
        <label>Leverage<br><input type="number" name="leverage" placeholder="10" min="1" step="0.5" style="width:80px;"></label>
        <label><input type="checkbox" name="use_bayesian" checked> Bayesian (Optuna)</label>
        <label><input type="checkbox" name="use_atr_sl" checked> ATR-adaptive SL</label>
        <button type="submit" class="btn primary">Run Backtest</button>
      </form>
      <details style="margin-top:10px;">
        <summary class="hint" style="cursor:pointer;">▼ Backup: run on Kaggle instead</summary>
        <p class="hint">
          Pushes these same values into the Kaggle kernel's own editor and
          leaves the run queued — click "Run on Kaggle" (appears once the
          push succeeds) to open it and hit "Save &amp; Run All" yourself
          for full, visible console output, which then syncs its result
          back to this page automatically. Use this if GitHub Actions is
          unavailable or you want to watch the run live. See KAGGLE.md
          Part K.
        </p>
        <button type="button" id="btn-run-kaggle" class="btn">Sync to Kaggle</button>
        <a id="btn-run-on-kaggle" class="btn" href="#" target="_blank" rel="noopener" style="display:none; text-decoration:none; margin-left:8px;">Run on Kaggle →</a>
      </details>
      <div id="backtest-status" class="mono" style="margin-top:8px; font-size:12px; color:var(--text-dim);"></div>
    </div>
    <div class="grid cols-2">
      <div class="card">
        <h3>Walkforward Runs</h3>
        <table id="tbl-wf">
          <thead><tr><th>Run</th><th>Return</th><th>Win Rate</th><th>Trades</th><th>Finished</th></tr></thead>
          <tbody></tbody>
        </table>
        <div class="empty-state" id="empty-wf" style="display:none;">
          No walkforward runs logged yet — run <code class="mono">python3 walkforward.py</code> to log one.
        </div>
      </div>
      <div class="card">
        <h3>Daily Optimizer Runs</h3>
        <table id="tbl-opt">
          <thead><tr><th>Run</th><th>BTC bal</th><th>ETH bal</th><th>Finished</th></tr></thead>
          <tbody></tbody>
        </table>
        <div class="empty-state" id="empty-opt" style="display:none;">
          No optimizer runs logged yet — <code class="mono">daily_optimizer()</code> is triggered once a
          day by the GitHub Actions cron tick (whichever ~5-minute tick first reaches a new UTC day;
          not a fixed 00:03 anymore under the current hosting — see SPEC.md Section 3), and only a
          <em>completed</em> run is recorded here. If the Live Monitor page's Engine Heartbeat shows the
          cron job ticking but this stays empty past a full day, check the GitHub Actions run history for
          errors inside <code class="mono">daily_optimizer()</code> itself.
        </div>
      </div>
    </div>
  </main>
  <footer class="hint">Click a run to see its full metrics/params payload.</footer>
</div>

<!-- Run-detail modal — 2026-10-26, replaces the old inline raw-JSON card -->
<div class="modal-overlay hidden" id="run-modal" onclick="if (event.target === this) closeDetail()">
  <div class="modal-card">
    <button class="modal-close" onclick="closeDetail()" aria-label="Close">&times;</button>
    <h3 id="modal-title">Run #—</h3>
    <div class="modal-sub" id="modal-sub">—</div>
    <div id="modal-body">Loading…</div>
  </div>
</div>

<script src="./assets/app.js"></script>
<script>
function closeDetail() {
  document.getElementById("run-modal").classList.add("hidden");
}
document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeDetail(); });

function _kvGrid(obj) {
  const keys = Object.keys(obj || {});
  if (keys.length === 0) return `<div class="empty-state" style="padding:8px 0;">None</div>`;
  return `<div class="kv-grid">${keys.map(k => `
    <div class="kv-row"><span class="kv-key">${k}</span><span class="kv-val">${
      obj[k] === null || obj[k] === undefined ? "—" : String(obj[k])
    }</span></div>`).join("")}</div>`;
}

async function showDetail(runId) {
  const modal = document.getElementById("run-modal");
  const body = document.getElementById("modal-body");
  document.getElementById("modal-title").textContent = `Run #${runId}`;
  document.getElementById("modal-sub").textContent = "Loading…";
  body.innerHTML = "Loading…";
  modal.classList.remove("hidden");
  try {
    const run = await apiGet(`/runs/${runId}`);
    let params = {};
    try { params = typeof run.params === "string" ? JSON.parse(run.params) : (run.params || {}); } catch {}
    document.getElementById("modal-sub").textContent =
      `${run.run_type || "—"} · ${run.status || "—"} · finished ${fmtTime(run.finished_at)}`;
    body.innerHTML = `
      <div class="modal-section">
        <h4>Metrics</h4>
        ${_kvGrid(run.metrics || {})}
      </div>
      <div class="modal-section">
        <h4>Parameters used</h4>
        ${_kvGrid(params)}
      </div>
      ${run.error ? `<div class="modal-section"><h4>Error</h4><div class="modal-error">${run.error}</div></div>` : ""}
      ${run.kaggle_ref ? `<div class="modal-section"><h4>Kaggle reference</h4><div class="mono" style="font-size:13px;">${run.kaggle_ref}</div></div>` : ""}
      <div class="modal-section" id="modal-trades-section" style="display:none;">
        <h4>Per-trade data</h4>
        <div id="modal-trades-body"></div>
      </div>
    `;
    // 2026-10-28: per-trade data (foundation for the future
    // Backtest-vs-Live comparison — PLAN.md's 2026-10-27 Decisions
    // entry). Loaded separately/lazily since it's a second request and
    // most runs predate this feature (empty list, nothing to show).
    if (run.run_type === "walkforward") {
      try {
        const t = await apiGet(`/runs/${runId}/trades`);
        if (t.trades && t.trades.length > 0) {
          const section = document.getElementById("modal-trades-section");
          const tbody = document.getElementById("modal-trades-body");
          if (section) section.style.display = "block";
          if (tbody) {
            tbody.innerHTML = `
              <table style="font-size:12px;">
                <thead><tr><th>Symbol</th><th>Side</th><th>Entry</th><th>Exit</th><th>Exit via</th><th>PnL %</th><th>Opened</th></tr></thead>
                <tbody>${t.trades.map(tr => `
                  <tr>
                    <td class="mono">${tr.symbol ?? "—"}</td>
                    <td class="${tr.side === 'Buy' ? 'side-buy' : 'side-sell'}">${tr.side ?? "—"}</td>
                    <td class="mono">${fmtPrice(tr.entry_price)}</td>
                    <td class="mono">${fmtPrice(tr.exit_price)}</td>
                    <td>${tr.exit_leg ?? "—"}</td>
                    <td class="mono ${pnlClass(tr.pnl_pct)}">${fmtPct(tr.pnl_pct)}</td>
                    <td>${fmtTime(tr.entry_ts)}</td>
                  </tr>`).join("")}</tbody>
              </table>
              <div class="hint" style="margin-top:6px;">${t.trades.length} trade(s) — foundation data for the future Backtest-vs-Live comparison, not yet surfaced on the Compare page.</div>
            `;
          }
        }
      } catch (e) {
        // Non-fatal — older runs simply have no persisted trades yet.
      }
    }
  } catch (e) {
    document.getElementById("modal-sub").textContent = "Error";
    body.innerHTML = `<div class="modal-error">Could not load run: ${e.message}</div>`;
  }
}

async function loadRuns() {
  const bannerSlot = document.getElementById("banner-slot");
  try {
    const wf = await apiGet("/runs", { run_type: "walkforward" });
    const wfBody = document.querySelector("#tbl-wf tbody");
    if (wf.runs.length === 0) {
      document.getElementById("empty-wf").style.display = "block";
    } else {
      wfBody.innerHTML = wf.runs.map(r => {
        const m = r.metrics || {};
        return `
        <tr style="cursor:pointer;" onclick="showDetail(${r.id})">
          <td class="mono">#${r.id}</td>
          <td class="mono">${m["Total Return (%)"] ?? "—"}%</td>
          <td class="mono">${m["Win Rate (%)"] ?? "—"}%</td>
          <td class="mono">${m["Total Trades"] ?? "—"}</td>
          <td>${fmtTime(r.finished_at)}</td>
        </tr>`;
      }).join("");
    }

    const opt = await apiGet("/runs", { run_type: "daily_optimizer" });
    const optBody = document.querySelector("#tbl-opt tbody");
    if (opt.runs.length === 0) {
      document.getElementById("empty-opt").style.display = "block";
    } else {
      optBody.innerHTML = opt.runs.map(r => {
        const m = r.metrics || {};
        return `
        <tr style="cursor:pointer;" onclick="showDetail(${r.id})">
          <td class="mono">#${r.id}</td>
          <td class="mono">${fmtMoney(m.btc_val)}</td>
          <td class="mono">${fmtMoney(m.eth_val)}</td>
          <td>${fmtTime(r.finished_at)}</td>
        </tr>`;
      }).join("");
    }
  } catch (e) {
    bannerSlot.innerHTML = `<div class="banner error">Could not reach the API (${e.message}).</div>`;
  }
}
loadRuns();

// ── Run-a-backtest form (Kaggle integration — see KAGGLE.md) ─────────────
let _pollTimer = null;

function _pollRun(runId) {
  const statusEl = document.getElementById("backtest-status");
  clearInterval(_pollTimer);
  _pollTimer = setInterval(async () => {
    try {
      const run = await apiGet(`/runs/${runId}`);
      if (run.status === "completed") {
        clearInterval(_pollTimer);
        statusEl.textContent = `Run #${runId} completed.`;
        loadRuns();
      } else if (run.status === "failed") {
        clearInterval(_pollTimer);
        statusEl.textContent = `Run #${runId} failed: ${run.error || "unknown error"}`;
      } else {
        statusEl.textContent = `Run #${runId}: ${run.status}…`;
      }
    } catch (e) {
      statusEl.textContent = `Lost track of run #${runId} (${e.message}) — check the Kaggle dashboard directly.`;
      clearInterval(_pollTimer);
    }
  }, 15000); // Kaggle's own queue is usually minutes, not seconds — no need to poll faster
}

function _formBody() {
  const fd = new FormData(document.getElementById("backtest-form"));
  const body = {};
  for (const k of ["walk_forward_days", "bayesian_trials"]) {
    if (fd.get(k)) body[k] = parseInt(fd.get(k), 10);
  }
  if (fd.get("leverage")) body.leverage = parseFloat(fd.get("leverage"));
  body.use_bayesian = fd.get("use_bayesian") === "on";
  body.use_atr_sl = fd.get("use_atr_sl") === "on";
  return body;
}

// 2026-10-29: GitHub Actions is now the primary, default path — it's
// been confirmed working live (the sys.path ModuleNotFoundError that
// blocked it is fixed), so "Run Backtest" triggers it directly with no
// manual step. Kaggle (the original design, still fully wired) is kept
// as a backup behind the "▼ Backup: run on Kaggle instead" disclosure —
// "Sync to Kaggle" pushes code+params into the kernel's own editor and
// leaves it queued; "Run on Kaggle" (revealed on a successful push)
// opens that kernel in a new tab for a human to click "Save & Run All"
// themselves for full, visible console output. Both paths sync their
// result back here via the same pyquant_runs row every run already polls.
document.getElementById("backtest-form").addEventListener("submit", async (e) => {
  e.preventDefault();
  const statusEl = document.getElementById("backtest-status");
  statusEl.textContent = "Submitting to GitHub Actions…";
  try {
    const result = await apiPost("/backtests", _formBody());
    statusEl.textContent = `Run #${result.run_id} queued — GitHub Actions is starting it now.`;
    _pollRun(result.run_id);
  } catch (err) {
    statusEl.textContent = "Could not start the run: " + err.message;
  }
});

document.getElementById("btn-run-kaggle").addEventListener("click", async () => {
  const statusEl = document.getElementById("backtest-status");
  const runOnKaggleBtn = document.getElementById("btn-run-on-kaggle");
  runOnKaggleBtn.style.display = "none";

  statusEl.textContent = "Pushing to Kaggle…";
  try {
    const result = await apiPost("/backtests/sync-to-kaggle", _formBody());
    statusEl.textContent = `Run #${result.run_id} pushed and queued.`;
    runOnKaggleBtn.href = result.kaggle_kernel_url;
    runOnKaggleBtn.style.display = "inline-block";
    _pollRun(result.run_id);
  } catch (err) {
    statusEl.textContent = "Could not push to Kaggle: " + err.message;
  }
});
</script>
</body>
</html>
</file>

<file path="legacy_web/compare.html">
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PyQuant — Compare</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="./assets/style.css">
</head>
<body>
<div class="app-shell">
  <header class="topbar">
    <div class="brand">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 17L9 11L13 15L21 7" stroke="#5B8DEF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 7H21V13" stroke="#5B8DEF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="name">PyQuant</span>
      <span class="subtitle">Control Center</span>
    </div>
    <div class="mode-switch" id="mode-switch"></div>
  </header>
  <nav class="primary">
    <a href="index.html">Dashboard</a>
    <a href="live-monitor.html">Live Monitor</a>
    <a href="signals.html">Signals</a>
    <a href="backtest.html">Backtest</a>
    <a href="compare.html">Compare</a>
    <a href="settings.html">API Keys &amp; Settings</a>
  </nav>
  <main>
    <div id="banner-slot">
      <div class="banner warn">
        v1, aggregate-only: this compares <em>summary</em> stats (win rate,
        average return) side by side — it does not yet match individual
        live trades to individual backtest trades one-for-one. See the
        brainstorm note at the bottom of this page and PLAN.md for why,
        and what a true per-trade version would need.
      </div>
    </div>
    <div class="grid cols-2">
      <div class="card">
        <h3>Live (Signal-Only Tracking)</h3>
        <div id="live-stats" class="grid cols-2" style="gap:14px;">
          <div class="empty-state">Loading…</div>
        </div>
        <p class="hint" id="live-since" style="margin-top:12px; margin-bottom:0;"></p>
      </div>
      <div class="card">
        <h3>Latest Walkforward Backtest</h3>
        <div id="wf-stats" class="grid cols-2" style="gap:14px;">
          <div class="empty-state">Loading…</div>
        </div>
        <p class="hint" id="wf-when" style="margin-top:12px; margin-bottom:0;"></p>
      </div>
    </div>

    <div class="card" style="margin-top:16px;">
      <h3>Brainstorm — toward a true per-trade comparison</h3>
      <p class="hint" style="margin-top:-4px;">
        Captured here per the owner's request to "properly brainstorm and
        look into the concept architecture and setup for this" — kept as
        a living note, not a committed roadmap item yet. Full version
        lives in PLAN.md.
      </p>
      <ul style="font-size:13px; color:var(--text-dim); line-height:1.6; margin:0; padding-left:20px;">
        <li><strong>What v1 has:</strong> live side uses <code class="mono">pyquant_signals</code>
          (every real signal PyQuant opened/closed, with <code class="mono">realized_pnl_pct</code>).
          Backtest side uses <code class="mono">pyquant_runs.metrics</code> — aggregate numbers only
          (<code class="mono">Total Return (%)</code>, <code class="mono">Win Rate (%)</code>,
          <code class="mono">Total Trades</code>) from whichever walkforward run finished last.</li>
        <li><strong>What's missing for per-trade matching:</strong>
          <code class="mono">walkforward.py</code>'s <code class="mono">run_walk_forward()</code>
          already builds an <code class="mono">all_trades</code> list internally (entry/exit price,
          side, PnL, timestamp per simulated trade) — it's just never persisted past the
          in-memory return value. A per-trade comparison needs a new
          <code class="mono">pyquant_backtest_trades</code> table (run_id FK, symbol, side, entry/exit
          price+time, pnl_pct) populated from that same list at save time, mirroring how
          <code class="mono">pyquant_signals</code> already works for the live side.</li>
        <li><strong>Matching strategy once that exists:</strong> not a 1:1 trade-id match (the UKF
          signal model is deterministic given the same inputs, but live ticks on a 5-minute
          cadence against real-time bars while the backtest walks fixed historical windows —
          timestamps won't line up exactly). The practical approach: bucket both sides by
          calendar day (or week) and compare trade count / win rate / avg return per bucket,
          which tolerates the timing skew while still being far more granular than one
          whole-history number each.</li>
        <li><strong>Why this is v2, not now:</strong> it's a real schema addition
          (<code class="mono">pyquant_backtest_trades</code>) plus a <code class="mono">walkforward.py</code>
          change to persist <code class="mono">all_trades</code> — exactly the kind of thing that
          should follow, not block, getting the aggregate version (this page) out and the
          Kaggle-manual-trigger path (Backtest page's "Sync to Kaggle") working first.</li>
      </ul>
    </div>
  </main>
  <footer class="hint">
    "Live" figures respect the Settings page's signals baseline, same as the Dashboard —
    see Settings → "Signals Baseline" if these numbers look like they include pre-fix history.
  </footer>
</div>
<script src="./assets/app.js"></script>
<script>
function _statTile(label, value, cls) {
  return `<div><div class="stat-value ${cls || ''}">${value}</div><div class="stat-label">${label}</div></div>`;
}

async function loadCompare() {
  try {
    const d = await apiGet("/compare");

    const live = d.live || {};
    document.getElementById("live-stats").innerHTML = [
      _statTile("Avg. Return", fmtPct(live.avg_pnl_pct), pnlClass(live.avg_pnl_pct)),
      _statTile("Win Rate", live.win_rate_pct != null ? `${live.win_rate_pct.toFixed(1)}%` : "—"),
      _statTile("Closed Trades", live.trade_count ?? "—"),
      _statTile("Wins / Losses", `${live.win_count ?? "—"} / ${live.loss_count ?? "—"}`),
    ].join("");
    document.getElementById("live-since").textContent = d.signals_baseline_at
      ? `Since baseline reset: ${fmtTime(d.signals_baseline_at)}`
      : "Counting all signal history (no baseline set).";

    const wf = d.latest_walkforward_run;
    if (!wf) {
      document.getElementById("wf-stats").innerHTML =
        `<div class="empty-state">No completed walkforward run yet — use the Backtest page.</div>`;
      document.getElementById("wf-when").textContent = "";
    } else {
      const m = wf.metrics || {};
      const retPct = m["Total Return (%)"];
      const retFrac = retPct !== undefined && retPct !== null ? retPct / 100 : null;
      document.getElementById("wf-stats").innerHTML = [
        _statTile("Total Return", retFrac !== null ? fmtPct(retFrac) : "—", pnlClass(retFrac)),
        _statTile("Win Rate", m["Win Rate (%)"] !== undefined ? `${m["Win Rate (%)"]}%` : "—"),
        _statTile("Total Trades", m["Total Trades"] ?? m["trade_count"] ?? "—"),
        _statTile("Run", `#${wf.id}`),
      ].join("");
      document.getElementById("wf-when").textContent = `Finished ${fmtTime(wf.finished_at)}`;
    }
  } catch (e) {
    document.getElementById("banner-slot").innerHTML += `<div class="banner error">Could not reach the API (${e.message}).</div>`;
  }
}
loadCompare();
</script>
</body>
</html>

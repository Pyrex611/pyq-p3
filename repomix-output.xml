# ── Logging ───────────────────────────────────────────────────────────────────
logger = logging.getLogger(__name__)
logger.setLevel(logging.INFO)

_console_h = logging.StreamHandler()
_console_h.setLevel(logging.INFO)
_file_h = logging.FileHandler("pyq_p4.log")

            # Watchdog Processing
            watchdog.process_minute_bar(
                symbol="BTCUSDT" if "BTC" in i else "ETHUSDT",
                bar_open=float(one_data["open"]),
                bar_high=hhigh,
                bar_low=llow,
                bar_close=price
            )

            # SIGNAL_ONLY_MODE: stateless, DB-driven TP/SL close-check —
            # see _check_signal_only_closes()'s docstring (2026-10-25
            # incident) for why this runs alongside, not instead of, the

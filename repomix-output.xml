      </div>
      <div class="card">
        <h3>Recently Closed</h3>
        <table id="tbl-closed">
          <thead><tr><th>Symbol</th><th>Side</th><th>Outcome</th><th>PnL</th><th>Closed</th></tr></thead>
          <tbody></tbody>
        </table>
        <div class="empty-state" id="empty-closed" style="display:none;">No closed signals logged yet.</div>
      </div>
    </div>
  </main>
  <footer class="hint">Data refreshes on page load. Trading toggle takes effect on the next scheduled hourly cycle.</footer>
</div>
<script src="./assets/app.js"></script>
<script>
async function loadDashboard() {
  const bannerSlot = document.getElementById("banner-slot");
  try {
    const d = await apiGet("/dashboard");

    document.getElementById("stat-open").textContent = d.open_positions.length;
    document.getElementById("stat-pnl").textContent = fmtMoney(d.realized_pnl_recent);
    document.getElementById("stat-pnl").className = "stat-value " + pnlClass(d.realized_pnl_recent);
    document.getElementById("stat-trading").textContent = d.trading_enabled ? "ON" : "OFF";
    document.getElementById("stat-mode").textContent = d.mode.toUpperCase() + " mode";
    if (d.last_run) {
      document.getElementById("stat-last-run").textContent = d.last_run.run_type;
      document.getElementById("stat-last-run-time").textContent = fmtTime(d.last_run.finished_at);
    } else {
      document.getElementById("stat-last-run").textContent = "—";
      document.getElementById("stat-last-run-time").textContent = "no runs logged yet";
    }

    const openBody = document.querySelector("#tbl-open tbody");
    if (d.open_positions.length === 0) {
      document.getElementById("empty-open").style.display = "block";
    } else {
      openBody.innerHTML = d.open_positions.map(s => `
        <tr>
          <td class="mono">${s.symbol}</td>
          <td class="${s.side === 'BUY' ? 'side-buy' : 'side-sell'}">${s.side}</td>
          <td class="mono">${fmtPrice(s.entry_price)}</td>
          <td class="mono">${fmtPrice(s.sl_price)}</td>
          <td class="mono">${fmtPrice(s.tp_price)}</td>
          <td>${fmtTime(s.opened_at)}</td>
        </tr>`).join("");
    }

    const closedBody = document.querySelector("#tbl-closed tbody");
    if (d.recent_closed.length === 0) {
      document.getElementById("empty-closed").style.display = "block";
    } else {
      closedBody.innerHTML = d.recent_closed.map(s => `
        <tr>
          <td class="mono">${s.symbol}</td>
          <td class="${s.side === 'BUY' ? 'side-buy' : 'side-sell'}">${s.side}</td>
          <td><span class="pill ${s.status}">${statusLabel(s.status)}</span></td>
          <td class="${pnlClass(s.realized_pnl)}">${fmtMoney(s.realized_pnl)}</td>
          <td>${fmtTime(s.closed_at)}</td>
        </tr>`).join("");
    }
  } catch (e) {
    bannerSlot.innerHTML = `<div class="banner error">Could not reach the API (${e.message}). Check that the backend is deployed and PYQUANT_API_BASE / the /api rewrite is configured.</div>`;
  }
}
loadDashboard();
</script>

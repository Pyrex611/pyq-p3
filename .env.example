ALPACA_API_KEY=
ALPACA_SECRET_KEY=

BYBIT_API_KEY=
BYBIT_SECRET_KEY=

BINANCE_API_KEY=
BINANCE_SECRET_KEY=

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Phase 1 additions ─────────────────────────────────────────────────────
# "live" (default, real mainnet trading) or "paper" (Binance Futures
# TESTNET — real execution-path validation, no real capital at risk).
PYQUANT_MODE=live

# Only required when PYQUANT_MODE=paper. Get these from
# testnet.binancefuture.com — mainnet keys above do NOT work here.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# Optional. When unset, pyquant_state.py falls back to a local SQLite file
# (pyquant_state.sqlite3) — fine for a single VPS/orchestra process. Set
# this to a Postgres connection string for the Vercel deployment, where
# local disk isn't durable between invocations. Format:
#   postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

.env
btc_back365.csv
btc_back366.csv
eth_back365.csv
eth_back366.csv

# Phase 1: local SQLite state-store fallback (used only when DATABASE_URL
# is unset) — pure runtime state, never meant to be committed.
pyquant_state.sqlite3
pyquant_state.sqlite3-journal
pyquant_state.sqlite3-wal
pyquant_state.sqlite3-shm

# Phase 2: Python bytecode cache + Vercel's local build output
__pycache__/
*.pyc
.vercel/

# 2026-10-29 Next.js migration: node deps + build output, standard
# Next.js ignores. package-lock.json IS committed (reproducible builds).
node_modules/
.next/
npm-debug.log*

# GitHub Actions cron migration: the database (pyquant_state.py) is now
# the source of truth for all of this — these are purely local, best-
# effort mirrors. Purged from existing git history too (see
# GITHUB_ACTIONS_SETUP.md's "What was purged" section) since the repo is
# now public and this is operational/strategy detail, not just clutter.
*.log
optimal_params.json
active_trades.json
watchdog_trades.json
last_execution_timestamp.txt
minute_execution_timestamp.txt